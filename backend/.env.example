# MySQL connection (same database the original PHP app used)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicore_hms
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Server
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
